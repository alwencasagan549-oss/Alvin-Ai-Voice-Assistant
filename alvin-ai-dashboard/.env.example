# Leave blank to use the Vite dev proxy (recommended for local dev).
# For a separately hosted backend, set VITE_API_BASE_URL to the reachable origin.
VITE_API_BASE_URL=
# Optional; auto-derived from VITE_API_BASE_URL when blank.
VITE_WS_URL=
# Only used when backend API_KEY is set. Sent as ?token=...
# Browsers cannot set WebSocket headers, so this is the only option.
# WARNING: visible in the page source — use a short-lived server-issued
# token in production, not a long-lived shared secret.
VITE_API_KEY=

# Dev proxy only (ignored in production builds).
# Set to point the dev proxy at a LAN/staging backend.
VITE_DEV_BACKEND_URL=