# Alvin STT service — sample configuration.
# Copy to .env and tune as needed.
# Loopback is safe for local use. Set an API_KEY before binding to a shared network.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

WHISPER_LANGUAGE=en

VAD_THRESHOLD=0.65
MIN_SILENCE_DURATION_MS=700
SPEECH_PAD_MS=30

SAMPLE_RATE=16000
PARTIAL_INTERVAL_MS=1000
MIN_SEGMENT_SECONDS=0.7
MAX_SEGMENT_SECONDS=20

MAX_CONNECTIONS=64
# Maximum size of a single WebSocket binary frame (bytes). Prevents DoS.
MAX_FRAME_SIZE=1048576
# Cap the per-connection transcription queue so a slow consumer can't
# exhaust memory. Each item is a small audio segment (~0.5-1s).
TRANSCRIPTION_QUEUE_MAXSIZE=100

# --- silence gate ----------------------------------------------------------
# Buffers quieter than this (dBFS RMS) never reach a backend.
SILENCE_THRESHOLD_DBFS=-42.0

# Cloud primary. The Opus payload is encoded in memory by soundfile
# (libsndfile ships in the wheel), so no ffmpeg binary is needed.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GROQ_LANGUAGE=en
GROQ_FALLBACK=true
# Breaker floor; longer audio gets GROQ_TIMEOUT_BASE_SEC + slope * duration.
GROQ_TIMEOUT_SEC=1.5
GROQ_TIMEOUT_BASE_SEC=1.0
GROQ_TIMEOUT_SLOPE_SEC=0.12
# Vocabulary/formatting steer for Whisper. Empty disables it.
GROQ_INITIAL_PROMPT=Cagayan de Oro City, order IDs like 4829-B, email addresses like test@domain.org. The speaker is talking to a voice assistant. Ignore silence and background noise.
# Prime the TLS connection pool at startup so the first turn is not slower.
GROQ_WARMUP=true

# Local fallback (used whenever the cloud times out or errors).
FALLBACK_MODEL=base.en
PRELOAD_FALLBACK=true
CPU_THREADS=4

# --- TTS -------------------------------------------------------------------
TTS_VOICE=en-US-AndrewNeural
# Sentences fetched from edge-tts ahead of the consumer.
TTS_PREFETCH=4
# Edge silence quieter than this (dBFS) is trimmed from each sentence.
TTS_SILENCE_THRESHOLD_DBFS=-45.0
# Audio held back at the START of a sentence to allow leading-silence removal.
# This is cheap (just delays the first audio slightly).
TTS_TRIM_LEADING_MS=10
# Audio held back at the END of a sentence to allow trailing-silence removal.
# This needs to be larger (e.g., 60ms) to detect real end-of-sentence silence.
TTS_TRIM_TRAILING_MS=60
# Digital silence inserted between trimmed sentences.
TTS_SENTENCE_GAP_MS=40
# New MP3 bytes buffered before re-decoding during streaming. Higher reduces
# the re-decode cost; 8192 holds the first ~1 s of MP3 before decoding.
TTS_DECODE_INTERVAL_BYTES=8192
# Transient edge-tts fetches fail (429 / network blip); retry before giving up.
TTS_RETRIES=2
TTS_RETRY_BACKOFF_MS=150
# Timeout for a single edge-tts sentence fetch (seconds).
TTS_TIMEOUT_SEC=6.0
# Speak every final transcript back to the client automatically.
TTS_AUTO_SPEAK=false
# Synthesize and discard one short phrase at startup (removes the edge-tts
# cold start from the first spoken reply).
TTS_WARMUP=true

# --- admission control -----------------------------------------------------
# Shared secret required on /ws/transcribe when set. Send it as
# "Authorization: Bearer <key>" or "X-API-Key: <key>"; "?token=<key>" also
# works for browser clients but lands in access/proxy logs. Empty = open.
API_KEY=
# Legacy alias, only read when API_KEY is unset.
SERVICE_AUTH_TOKEN=

# --- LLM brain (Kilo AI Gateway) -------------------------------------------
# Conversational brain after STT. Get your key from the Kilo AI dashboard.
# Fastest consistently-working free model: nvidia/nemotron-3.5-lightning:free
# LLM_USE_CF_AS_PRIMARY=true makes Cloudflare the first provider and Kilo the fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.kilo.ai/api/gateway
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_ENABLED=true
LLM_USE_CF_AS_PRIMARY=true
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.7
LLM_SYSTEM_PROMPT=You are Alvin, a helpful, concise AI voice assistant created by Alwin T Casagan, a Full-Stack Developer and System Architect with 3+ years of experience who has built 20+ projects across a 10+ tech stack. Alwin is available for work and can be found on GitHub at alwincasagan549-oss. Keep responses short and natural, suitable for text-to-speech. Do not use emojis, markdown, or lists. Answer in plain text only.
LLM_TIMEOUT_SEC=15.0
LLM_WARMUP=true

# --- Cloudflare AI fallback (primary when LLM_USE_CF_AS_PRIMARY=true) ------
# Free @cf/ models available:
# @cf/meta/llama-3.2-3b-instruct (~880ms), @cf/meta/llama-3.3-70b-instruct-fp8-fast (~1130ms)
# Non-@cf models (deepseek etc.) require payment on the Cloudflare dashboard.
CF_API_KEY=
CF_ACCOUNT_ID=
CF_BASE_URL=https://api.cloudflare.com/client/v4/accounts
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CF_ENABLED=true
CF_TIMEOUT_SEC=10.0

# --- conversation memory ---------------------------------------------------
MAX_LLM_HISTORY=12
LLM_MAX_HISTORY_TOKENS=2000

# --- intent routing --------------------------------------------------------
# Deterministic device-command matching (stop / mute / volume / lights / ...)
# on the ITN-normalized final transcript. Recognized commands are relayed as
# {"type": "command"} events and never reach the LLM.
INTENT_ENABLED=true
# Speak a short confirmation after executing a matched command.
INTENT_SPEAK_CONFIRMATION=false
# Transcripts with a lower STT confidence than this are not trusted enough
# to execute a device command (they still reach the LLM as usual).
INTENT_MIN_CONFIDENCE=0.5

# --- wake word -------------------------------------------------------------
# Words that arm the command router, e.g. "alvin, turn on the lights".
WAKE_WORDS=alvin
# Require the wake word before a command executes. Recommended for a shared
# room: it stops the TV, a passing conversation, or background noise from
# toggling your lights. Leave false for a dedicated headset.
WAKE_WORD_REQUIRED=false
# Seconds of armed state after the wake word, so follow-up commands need
# no re-wake. 0 disables the window.
WAKE_WORD_WINDOW_SEC=0.0
# Speak a short "Yes?" when the user says only the wake word, with no command.
WAKE_SPEAK_ACK=true

# --- push to talk ----------------------------------------------------------
# Wake-word gating state, set by {"type": "talk", "active": true|false}.
# When PUSH_TO_TALK is on, audio is discarded unless the client is holding
# the key: the microphone is idle by default.
PUSH_TO_TALK=false
# Safety net: force listening off after this long. 0 disables the timeout.
PUSH_TO_TALK_TIMEOUT_MS=30000
# Run the half-duplex playback gate during a hold.
PUSH_TO_TALK_ECHO_GATE=true

# --- echo / self-trigger suppression ---------------------------------------
# "gate" = drop mic audio during playback, "filter" = drop echoes, "off" = disable
ECHO_MODE=filter
# Similarity threshold for self-echo detection.
ECHO_SIMILARITY_THRESHOLD=0.75
# Seconds of spoken history to compare against.
ECHO_HISTORY_SEC=30.0
# Cooldown after playback ends (ms).
ECHO_COOLDOWN_MS=600

# --- web search ------------------------------------------------------------
# Tavily API key for web search (get one at https://tavily.com)
TAVILY_API_KEY=
# Debug flag for logging search decisions
DEBUG=false

# --- speaker identification -------------------------------------------------
# Enable speaker identification using ECAPA-TDNN embeddings (requires speechbrain + torch)
SPEAKER_ENABLED=false
# Cosine similarity threshold for speaker matching (0-1, higher = stricter)
SPEAKER_SIMILARITY_THRESHOLD=0.75
# Minimum audio duration for identification (seconds)
SPEAKER_MIN_IDENTIFY_SEC=1.0
# Maximum audio duration for identification (seconds)
SPEAKER_MAX_IDENTIFY_SEC=5.0
# Path to persist speaker profiles
SPEAKER_PROFILES_PATH=speaker_profiles.pkl
