# Alvin STT service — sample configuration.
# Copy to .env and tune as needed.
# Loopback is safe for local use. Set an API_KEY before binding to a shared network.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

WHISPER_LANGUAGE=en

VAD_THRESHOLD=0.65
MIN_SILENCE_DURATION_MS=500
SPEECH_PAD_MS=30

SAMPLE_RATE=16000
PARTIAL_INTERVAL_MS=500
MIN_SEGMENT_SECONDS=0.5
MAX_SEGMENT_SECONDS=15

MAX_CONNECTIONS=64
# Maximum size of a single WebSocket binary frame (bytes). Prevents DoS.
MAX_FRAME_SIZE=1048576
# Cap the per-connection transcription queue so a slow consumer can't
# exhaust memory. Each item is a small audio segment (~0.5-1s).
TRANSCRIPTION_QUEUE_MAXSIZE=200
# Total worker threads across the two bounded audio pools (Opus encode is
# latency-critical and gets a small dedicated pool; TTS decode / Piper synth /
# speaker embeddings share the rest). Clamped to [1, 32].
AUDIO_WORKER_THREADS=8

# --- silence gate ----------------------------------------------------------
# Buffers quieter than this (dBFS RMS) never reach a backend.
# -45 catches whispering (~ -40 dBFS) while still filtering room noise.
SILENCE_THRESHOLD_DBFS=-45.0

# Cloud primary. The Opus payload is encoded in memory by soundfile
# (libsndfile ships in the wheel), so no ffmpeg binary is needed.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GROQ_LANGUAGE=en
# Breaker floor; longer audio gets GROQ_TIMEOUT_BASE_SEC + slope * duration.
# Increased for more reliable cloud STT on longer audio.
GROQ_TIMEOUT_SEC=5.0
GROQ_TIMEOUT_BASE_SEC=2.0
GROQ_TIMEOUT_SLOPE_SEC=0.2
# Vocabulary/formatting steer for Whisper. Empty disables it.
GROQ_INITIAL_PROMPT=Cagayan de Oro City, order IDs like 4829-B, email addresses like test@domain.org. The speaker is talking to a voice assistant. Ignore silence and background noise.
# Prime the TLS connection pool at startup so the first turn is not slower.
GROQ_WARMUP=true

# --- Cloudflare STT (Workers AI) --------------------------------------------
# Free on Workers AI (no separate billing). Same CF_API_KEY/CF_ACCOUNT_ID as LLM.
# Model: @cf/openai/whisper-large-v3-turbo (~1-2s latency, cloud accuracy)
CF_STT_ENABLED=true
CF_STT_MODEL=@cf/openai/whisper-large-v3-turbo
CF_STT_TIMEOUT_SEC=15.0
# Use Cloudflare STT as primary (true = CF primary, Groq fallback; false = Groq primary, CF fallback)
CF_STT_USE_AS_PRIMARY=false
# Prime the Cloudflare STT connection pool at startup.
CF_STT_WARMUP=true

# --- TTS -------------------------------------------------------------------
TTS_VOICE=en-US-AndrewNeural
# Sentences fetched from edge-tts ahead of the consumer.
TTS_PREFETCH=4
# Edge silence quieter than this (dBFS) is trimmed from each sentence.
TTS_SILENCE_THRESHOLD_DBFS=-45.0
# Audio held back at the START of a sentence to allow leading-silence removal.
# This is cheap (just delays the first audio slightly).
TTS_TRIM_LEADING_MS=20
# Audio held back at the END of a sentence to allow trailing-silence removal.
# This needs to be larger (e.g., 80ms) to detect real end-of-sentence silence.
TTS_TRIM_TRAILING_MS=80
# Digital silence inserted between trimmed sentences.
TTS_SENTENCE_GAP_MS=30
# New MP3 bytes buffered before re-decoding during streaming. Lower decodes more
# frequently for lower latency; 4096 decodes ~2x more often.
TTS_DECODE_INTERVAL_BYTES=4096
# Transient edge-tts fetches fail (429 / network blip); retry before giving up.
TTS_RETRIES=5
TTS_RETRY_BACKOFF_MS=200
# Timeout for a single edge-tts sentence fetch (seconds).
TTS_TIMEOUT_SEC=20.0
# Speak every final transcript back to the client automatically.
TTS_AUTO_SPEAK=false
# Synthesize and discard one short phrase at startup (removes the edge-tts
# cold start from the first spoken reply).
TTS_WARMUP=true

# --- Piper TTS (fallback when Edge TTS fails) --------------------------------
# Enable Piper TTS as a local fallback when Edge TTS is not responding.
# Requires piper-tts package and a downloaded ONNX voice model in the model dir.
PIPER_TTS_ENABLED=true
# Piper voice name (e.g., en_US-lessac-medium, en_US-ryan-medium, en_GB-cori-medium).
# Download with: python -m piper.download_voices <voice> --download-dir <dir>
PIPER_TTS_VOICE=en_US-ryan-high
# Directory containing Piper .onnx and .onnx.json model files.
PIPER_TTS_MODEL_DIR=piper_voices

# --- admission control -----------------------------------------------------
# Shared secret required on /ws/transcribe when set. Send it as
# "Authorization: Bearer <key>" or "X-API-Key: <key>"; "?token=<key>" also
# works for browser clients but lands in access/proxy logs. Empty = open.
API_KEY=
# Legacy alias, only read when API_KEY is unset.
SERVICE_AUTH_TOKEN=

# --- LLM provider priority / fallback chain --------------------------------
# Providers are tried in order: primary first, then fallback on error or
# timeout. If all fail, the raw STT transcript is spoken as a last resort.
# Primary provider options: "cf" (Cloudflare), "nvidia" (NVIDIA NIM), "kilo" (Kilo AI Gateway)
# Fallback order: cf -> nvidia -> kilo (skipping disabled/unconfigured providers)
# LLM_PRIMARY_PROVIDER=cf
# Set NVIDIA_ENABLED=true to add the NVIDIA NIM direct provider to the chain.
# Both LLM_API_KEY (Kilo AI) and CF_API_KEY (Cloudflare) must be set for their
# respective providers to be active; NVIDIA_API_KEY enables the NVIDIA provider.
# DEPRECATED: LLM_USE_CF_AS_PRIMARY=true/false (use LLM_PRIMARY_PROVIDER instead)
# --- LLM brain (Kilo AI Gateway) -------------------------------------------
# Conversational brain after STT. Get your key from the Kilo AI dashboard.
# Fastest consistently-working free model: nvidia/nemotron-3.5-lightning:free
# LLM_USE_CF_AS_PRIMARY=true makes Cloudflare the first provider and Kilo the fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.kilo.ai/api/gateway
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# Vision-capable model used while the camera is open; the main brain above
# takes over again as soon as the camera closes.
LLM_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LLM_ENABLED=true
LLM_PRIMARY_PROVIDER=cf
LLM_USE_CF_AS_PRIMARY=true
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7
LLM_SYSTEM_PROMPT=You are Alvin, a helpful, concise AI voice assistant created by Alwin T Casagan, a Full-Stack Developer and System Architect with 3+ years of experience who has built 20+ projects across a 10+ tech stack. Alwin is available for work and can be found on GitHub at alwincasagan549-oss. Keep responses short and natural, suitable for text-to-speech. Do not use emojis, markdown, or lists. Answer in plain text only.
# Reduced for faster fallback when primary is slow/unavailable.
LLM_TIMEOUT_SEC=8.0
LLM_WARMUP=true

# --- Cloudflare AI fallback (primary when LLM_USE_CF_AS_PRIMARY=true) ------
# Free @cf/ models available:
# @cf/meta/llama-3.2-3b-instruct (~880ms), @cf/meta/llama-3.3-70b-instruct-fp8-fast (~1130ms)
# Non-@cf models (deepseek etc.) require payment on the Cloudflare dashboard.
# Using 3b model as primary for speed (~880ms vs ~1130ms).
CF_API_KEY=
CF_ACCOUNT_ID=
CF_BASE_URL=https://api.cloudflare.com/client/v4/accounts
CF_MODEL=@cf/meta/llama-3.2-3b-instruct
CF_ENABLED=true
# Reduced timeout for faster fallback detection.
CF_TIMEOUT_SEC=6.0

# --- NVIDIA NIM (direct provider) ------------------------------------------
# NVIDIA NIM direct API as an LLM provider. Get your API key from
# https://build.nvidia.com. NVIDIA_API_KEY enables this provider.
# NVIDIA_ENABLED=true adds NVIDIA to the LLM fallback chain.
NVIDIA_API_KEY=
# NVIDIA NIM endpoint (OpenAI-compatible).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model to use on the NVIDIA NIM endpoint.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Vision model on the NVIDIA endpoint used for camera turns.
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Enable NVIDIA direct provider (true/false).
NVIDIA_ENABLED=true
# Timeout for NVIDIA API calls (seconds).
NVIDIA_TIMEOUT_SEC=8.0

# --- conversation memory ---------------------------------------------------
MAX_LLM_HISTORY=12
LLM_MAX_HISTORY_TOKENS=2000

# --- intent routing --------------------------------------------------------
# Deterministic device-command matching (stop / mute / volume / lights / ...)
# on the ITN-normalized final transcript. Recognized commands are relayed as
# {"type": "command"} events and never reach the LLM.
INTENT_ENABLED=true
# Speak a short confirmation after executing a matched command.
INTENT_SPEAK_CONFIRMATION=false
# Transcripts with a lower STT confidence than this are not trusted enough
# to execute a device command (they still reach the LLM as usual).
INTENT_MIN_CONFIDENCE=0.5

# --- wake word -------------------------------------------------------------
# Words that arm the command router, e.g. "alvin, turn on the lights".
WAKE_WORDS=alvin
# Require the wake word before a command executes. Recommended for a shared
# room: it stops the TV, a passing conversation, or background noise from
# toggling your lights. Leave false for a dedicated headset.
WAKE_WORD_REQUIRED=false
# Seconds of armed state after the wake word, so follow-up commands need
# no re-wake. 0 disables the window.
WAKE_WORD_WINDOW_SEC=0.0
# Speak a short "Yes?" when the user says only the wake word, with no command.
WAKE_SPEAK_ACK=true

# --- push to talk ----------------------------------------------------------
# Wake-word gating state, set by {"type": "talk", "active": true|false}.
# When PUSH_TO_TALK is on, audio is discarded unless the client is holding
# the key: the microphone is idle by default.
PUSH_TO_TALK=false
# Safety net: force listening off after this long. 0 disables the timeout.
PUSH_TO_TALK_TIMEOUT_MS=30000
# Run the half-duplex playback gate during a hold.
PUSH_TO_TALK_ECHO_GATE=true

# --- echo / self-trigger suppression ---------------------------------------
# "gate" = drop mic audio during playback, "filter" = drop echoes, "off" = disable
ECHO_MODE=filter
# Similarity threshold for self-echo detection.
ECHO_SIMILARITY_THRESHOLD=0.75
# Seconds of spoken history to compare against.
ECHO_HISTORY_SEC=30.0
# Cooldown after playback ends (ms).
ECHO_COOLDOWN_MS=600

# --- web search ------------------------------------------------------------
# Primary search runs through the free Gemini CLI (npm install -g @google/gemini-cli),
# which uses its built-in Google Search grounding. Auth: either log in once with a
# personal Google account (run `gemini` and choose "Login with Google") or leave a
# GEMINI_API_KEY here for the CLI to pick up.
GEMINI_API_KEY=
# Optional: force a CLI model (e.g. gemini-2.5-flash). Empty = CLI default.
GEMINI_MODEL=
# Seconds before the CLI call gives up and DuckDuckGo takes over.
GEMINI_CLI_TIMEOUT_SEC=45
# Debug flag for logging search decisions
DEBUG=false

# --- speaker identification -------------------------------------------------
# Enable speaker identification using ECAPA-TDNN embeddings (requires speechbrain + torch)
SPEAKER_ENABLED=false
# Cosine similarity threshold for speaker matching (0-1, higher = stricter)
SPEAKER_SIMILARITY_THRESHOLD=0.75
# Minimum audio duration for identification (seconds)
SPEAKER_MIN_IDENTIFY_SEC=1.0
# Maximum audio duration for identification (seconds)
SPEAKER_MAX_IDENTIFY_SEC=5.0
# Path to persist speaker profiles
SPEAKER_PROFILES_PATH=speaker_profiles.pkl

# --- shutdown command -------------------------------------------------------
# The shutdown intent fires on any sentence containing "goodbye" ("alvin goodbye",
# "okay goodbye", "I think it is time to say goodbye"). Only the assistant's own
# server process is stopped -- never the operating system / laptop.
# The spoken acknowledgement before the server stops.
SHUTDOWN_RESPONSE_TEXT=At your service, sir. I will shut down all my system.
# Seconds to wait after speaking the shutdown acknowledgement before the
# server process receives SIGINT for graceful shutdown.
SHUTDOWN_DELAY_SEC=3.0

# --- laptop shutdown command ------------------------------------------------
# "Alvin, turn off my laptop" / "shut down the computer" powers off the local
# machine itself via the OS shutdown command (Windows: shutdown /s /t N).
# The spoken acknowledgement before the OS shutdown starts.
LAPTOP_SHUTDOWN_RESPONSE_TEXT=Shutting down your laptop now, sir. Goodbye.
# Windows shutdown countdown in seconds. Also the window in which the user can
# cancel the shutdown with `shutdown /a`.
LAPTOP_SHUTDOWN_DELAY_SEC=10

# --- YouTube playback -------------------------------------------------------
# Ad-free playback: the server resolves a direct yt-dlp stream and the HUD plays
# it in VLC/mpv/ffplay, so no YouTube ads are shown. If no local player is
# installed (or resolution fails), the watch page opens in the browser.
YOUTUBE_ADFREE=true
# Audio-only stream: less bandwidth, a faster start, and playback in the
# background with no player window (VLC runs headless). Set false to show the
# video in a local player window.
YOUTUBE_AUDIO_ONLY=true
# --- wake-up briefing -------------------------------------------------------
# "Alvin, wake up" greets the user with the date and time, reads the current
# weather, open tasks, and the latest email. The briefing is assembled from
# templates so it keeps working without an LLM; the LLM is an optional rewrite.
BRIEFING_ENABLED=true
# Speak the briefing on the wake_up intent (the HUD's wake-up flow).
BRIEFING_ON_WAKE_UP=true
# Prefetch weather/email at startup so the first wake-up does not wait on network.
BRIEFING_WARMUP=true

# Current weather (free, no API key, no signup): Open-Meteo resolves the city
# name and MET Norway returns the forecast.
BRIEFING_WEATHER_ENABLED=true
BRIEFING_WEATHER_LOCATION=Cagayan de Oro
BRIEFING_WEATHER_TIMEOUT_SEC=12
# Reuse the current reading for this long (seconds).
BRIEFING_WEATHER_CACHE_SEC=600

# Google Tasks (OAuth). Run `python scripts/google_tasks_auth.py` once, after
# placing your OAuth client in credentials/client_secret.json. Without a token
# the briefing says it could not reach the task list.
BRIEFING_TASKS_ENABLED=true
BRIEFING_TASKS_TOKEN_PATH=credentials/google_tasks_token.json
# "@default" or a task list ID.
BRIEFING_TASKS_LIST=@default
BRIEFING_TASKS_COUNT=5
BRIEFING_TASKS_TIMEOUT_SEC=6

# Gmail via IMAP with a Google app password. Read-only: the briefing fetches
# headers only and never marks messages as read. Set the user/password below;
# without them the briefing says it could not reach the inbox.
BRIEFING_EMAIL_ENABLED=true
BRIEFING_EMAIL_IMAP_HOST=imap.gmail.com
BRIEFING_EMAIL_IMAP_PORT=993
# The full Gmail address used to log in.
BRIEFING_EMAIL_IMAP_USER=
# A 16-character Google app password (not your account password).
BRIEFING_EMAIL_IMAP_PASSWORD=
BRIEFING_EMAIL_FOLDER=INBOX
BRIEFING_EMAIL_COUNT=3
BRIEFING_EMAIL_UNREAD_ONLY=true
BRIEFING_EMAIL_TIMEOUT_SEC=8
# Reuse fetched headers for this long (seconds).
BRIEFING_EMAIL_CACHE_SEC=120
# Skip one-time codes, verification, and password-reset mail, which should not
# be read out loud.
BRIEFING_EMAIL_SKIP_SENSITIVE=true

# Optional LLM rewrite of the templated briefing (one spoken paragraph).
BRIEFING_LLM_POLISH=false
BRIEFING_LLM_MAX_TOKENS=220
BRIEFING_LLM_TIMEOUT_SEC=10
